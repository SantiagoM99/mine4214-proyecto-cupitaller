# Solo lo usa la Entrega 2. Copiar como .env (en la raíz del repositorio) y ajustar.
# Todos los valores tienen un valor por defecto en src/entrega2/config.py.
DATABASE_URL=postgresql://mine4214:mine4214@127.0.0.1:5434/mine4214
EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPENAI_MODEL=gpt-6-luna
OPENAI_JUDGE_MODEL=gpt-6-sol
# Archivo de texto con la llave de OpenAI (una sola línea)
OPENAI_API_KEY_FILE=~/openai.txt
