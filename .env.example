# Solo lo usa la Entrega 2. Copiar como .env (en la raíz del repositorio) y ajustar.
# Todos los valores tienen un valor por defecto en src/entrega2/config.py.
DATABASE_URL=postgresql://mine4214:mine4214@127.0.0.1:5434/mine4214
EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPENAI_MODEL=gpt-6-luna
OPENAI_JUDGE_MODEL=gpt-6-sol
# Llave de OpenAI. IMPORTANTE: aquí va la RUTA a un archivo que contiene la llave,
# NO la llave misma. El archivo debe tener solo la llave, en una línea.
OPENAI_API_KEY_FILE=~/openai.txt
# Carpetas de los documentos del curso, si no están en data/bronce/documentos/
# E2_DIR_VIGENTE=data/bronce/documentos/vigentes
# E2_DIR_HISTORICO=data/bronce/documentos/historicos
